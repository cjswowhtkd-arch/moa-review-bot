# Firebase
FIREBASE_DB_URL=https://chosanghee00001-default-rtdb.firebaseio.com/categories.json
FIREBASE_AUTH_TOKEN=
# Optional: Naver Developers > Search API
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# Optional: Kakao Developers REST API key, used as Daum/Kakao search source
KAKAO_REST_API_KEY=
# Collection tuning
MAX_ITEMS_PER_CATEGORY=20
SOURCE_ITEM_LIMIT=12
SOURCE_CONCURRENCY=6
ARTICLE_CONCURRENCY=6
CATEGORY_CONCURRENCY=2
HTTP_TIMEOUT_MS=9000
ARTICLE_TIMEOUT_MS=6500
# Set to 0 if Daum public search HTML becomes unstable.
ENABLE_DAUM_HTML=1
# Set to 1 to print collected data without writing Firebase.
DRY_RUN=0
DRY_RUN_SUMMARY=0
